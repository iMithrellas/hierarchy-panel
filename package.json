{
  "name": "imithrellas-hierarchy-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Datasource-agnostic record hierarchy and observed lifetime timeline for Grafana",
  "scripts": {
    "build": "tsc --noEmit && webpack -c ./webpack.config.ts --env production",
    "sign": "sign-plugin",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "typecheck": "tsc --noEmit",
    "validate:release": "GRAFANA_PLUGIN_RELEASE=true npm run build && bash .github/scripts/validate_release.sh",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "node dev/seed.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react-data-grid": "7.0.0-beta.61",
    "js-cookie": "3.0.8"
  },
  "devDependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.0.1",
    "@grafana/eslint-config": "9.0.0",
    "@grafana/runtime": "13.0.1",
    "@grafana/sign-plugin": "3.3.3",
    "@grafana/ui": "13.0.1",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.15.0",
    "@types/node": "22.19.15",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "eslint": "9.39.5",
    "eslint-webpack-plugin": "5.0.3",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "11.1.0",
    "imports-loader": "5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.105.1",
    "sass-loader": "16.0.8",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.0",
    "terser-webpack-plugin": "5.6.1",
    "ts-node": "10.9.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "webpack": "5.110.3",
    "webpack-cli": "6.0.1",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-merge": "6.0.1",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  }
}
